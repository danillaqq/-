import csv
from collections import Counter
from dataclasses import dataclass
from datetime import date, timedelta
from enum import Enum


class TourType(Enum):
    BEACH = "Пляжний"
    EXCURSION = "Екскурсійний"
    ADVENTURE = "Пригодницький"


class BookingStatus(Enum):
    PENDING = "Очікує"
    CONFIRMED = "Підтверджено"
    CANCELED = "Скасовано"


@dataclass
class Customer:
    name: str
    email: str
    phone: str


class Tour:
    def __init__(self, title, price, duration, start_date, direction, tour_type):
        self._title = ""
        self._price = 0
        self._duration = 1
        self._start_date = None
        self.direction = direction
        self.tour_type = tour_type

        self.title = title
        self.price = price
        self.duration = duration
        self.start_date = start_date

    @property
    def title(self):
        return self._title

    @title.setter
    def title(self, value):
        if len(value.strip()) < 3:
            raise ValueError("Назва туру має містити мінімум 3 символи.")
        self._title = value

    @property
    def price(self):
        return self._price

    @price.setter
    def price(self, value):
        if value < 0:
            raise ValueError("Ціна туру не може бути від'ємною.")
        self._price = value

    @property
    def duration(self):
        return self._duration

    @duration.setter
    def duration(self, value):
        if value <= 0:
            raise ValueError("Тривалість має бути більше 0 днів.")
        self._duration = value

    @property
    def start_date(self):
        return self._start_date

    @start_date.setter
    def start_date(self, value):
        if value < date.today():
            raise ValueError("Дата початку туру не може бути в минулому.")
        self._start_date = value

    def is_available(self):
        return self.start_date >= date.today()

    def calculate_final_price(self):
        return self.price

    def __lt__(self, other):
        return self.calculate_final_price() < other.calculate_final_price()

    def __str__(self):
        return (f"{self.title} | {self.tour_type.value} | {self.direction} | "
                f"{self.start_date} | {self.duration} днів | "
                f"{self.calculate_final_price():.0f} грн")


class BeachTour(Tour):
    def __init__(self, title, price, duration, start_date, direction, all_inclusive):
        super().__init__(title, price, duration, start_date, direction, TourType.BEACH)
        self.all_inclusive = all_inclusive

    def calculate_final_price(self):
        return self.price * 1.2 if self.all_inclusive else self.price

    def __str__(self):
        meal = "все включено" if self.all_inclusive else "без харчування"
        return f"{super().__str__()} | {meal}"


class ExcursionTour(Tour):
    EXCURSION_COST = 300

    def __init__(self, title, price, duration, start_date, direction, excursions_count):
        super().__init__(title, price, duration, start_date, direction, TourType.EXCURSION)
        self.excursions_count = excursions_count

    @property
    def excursions_count(self):
        return self._excursions_count

    @excursions_count.setter
    def excursions_count(self, value):
        if value < 1:
            raise ValueError("Екскурсійний тур має містити хоча б одну екскурсію.")
        self._excursions_count = value

    def calculate_final_price(self):
        return self.price + self.excursions_count * self.EXCURSION_COST

    def __str__(self):
        return f"{super().__str__()} | екскурсій: {self.excursions_count}"


class AdventureTour(Tour):
    def __init__(self, title, price, duration, start_date, direction, difficulty):
        super().__init__(title, price, duration, start_date, direction, TourType.ADVENTURE)
        self.difficulty = difficulty

    @property
    def difficulty(self):
        return self._difficulty

    @difficulty.setter
    def difficulty(self, value):
        if not 1 <= value <= 5:
            raise ValueError("Складність туру має бути від 1 до 5.")
        self._difficulty = value

    def calculate_final_price(self):
        return self.price * (1 + 0.1 * self.difficulty)

    def __str__(self):
        return f"{super().__str__()} | складність: {self.difficulty}"


class Booking:
    def __init__(self, customer, tour):
        self.customer = customer
        self.tour = tour
        self.status = BookingStatus.PENDING

    @property
    def status(self):
        return self._status

    @status.setter
    def status(self, value):
        if not isinstance(value, BookingStatus):
            raise ValueError("Некоректний статус бронювання.")
        self._status = value

    def __enter__(self):
        print(f"\n--- Початок бронювання: {self.tour.title} ---")
        return self

    def confirm(self):
        self.status = BookingStatus.CONFIRMED
        print("Бронювання підтверджено.")

    def cancel(self):
        self.status = BookingStatus.CANCELED
        print("Бронювання скасовано.")

    def __exit__(self, exc_type, exc_val, exc_tb):
        if self.status == BookingStatus.PENDING:
            self.cancel()
        print(f"Фінальний статус: {self.status.value}")
        print("--- Завершення бронювання ---")


class TourManager:
    def __init__(self):
        self._tours = []
        self._bookings = []

    def add_tour(self, tour):
        self._tours.append(tour)
        print(f"Додано тур: {tour.title}")

    def add_booking(self, booking):
        self._bookings.append(booking)

    def show_all(self):
        print("\n--- Усі тури ---")
        for tour in self._tours:
            print(tour)

    def __iter__(self):
        return iter([tour for tour in self._tours if tour.is_available()])

    def find_tours(self, direction=None, max_price=None, date_from=None, date_to=None):
        for tour in self._tours:
            if direction and tour.direction != direction:
                continue
            if max_price is not None and tour.calculate_final_price() > max_price:
                continue
            if date_from and tour.start_date < date_from:
                continue
            if date_to and tour.start_date > date_to:
                continue
            yield tour

    def sorted_by_price(self):
        return sorted(self._tours)

    def sorted_by_start_date(self):
        return sorted(self._tours, key=lambda tour: tour.start_date)

    def export_popularity_csv(self, path):
        confirmed = Counter(
            booking.tour.direction
            for booking in self._bookings
            if booking.status == BookingStatus.CONFIRMED
        )
        with open(path, "w", newline="", encoding="utf-8") as file:
            writer = csv.writer(file)
            writer.writerow(["direction", "bookings"])
            writer.writerows(confirmed.most_common())


