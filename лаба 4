def read_int(prompt):
    try:
        return int(input(prompt))
    except ValueError:
        raise ValueError("Введіть ціле число.")


def read_float(prompt):
    try:
        return float(input(prompt))
    except ValueError:
        raise ValueError("Введіть число.")


def read_date(prompt):
    try:
        return datetime.strptime(input(prompt), "%d.%m.%Y").date()
    except ValueError:
        raise ValueError("Введіть дату у форматі ДД.ММ.РРРР.")


def read_customer():
    name = input("Ім'я клієнта: ")
    email = input("Email: ")
    phone = input("Телефон: ")
    return Customer(name, email, phone)


def read_two_tours(manager):
    manager.show_all()
    first = manager.tour_at(read_int("\nНомер першого туру: "))
    second = manager.tour_at(read_int("Номер другого туру: "))
    return first, second


def create_tour():
    print("\nТипи турів:")
    print("1 - Пляжний")
    print("2 - Екскурсійний")
    print("3 - Пригодницький")

    choice = input("Оберіть тип туру: ")
    if choice not in ("1", "2", "3"):
        raise ValueError("Некоректний тип туру.")

    title = input("Назва туру: ")
    price = read_float("Ціна: ")
    duration = read_int("Тривалість (днів): ")
    direction = input("Напрямок (країна): ")
    start_date = read_date("Дата початку (ДД.ММ.РРРР): ")

    if choice == "1":
        all_inclusive = input("Все включено? (так/ні): ").lower() == "так"
        return BeachTour(title, price, duration, all_inclusive, direction, start_date)
    if choice == "2":
        excursions = read_int("Кількість екскурсій: ")
        return ExcursionTour(title, price, duration, excursions, direction, start_date)
    difficulty = read_int("Складність (1-5): ")
    return AdventureTour(title, price, duration, difficulty, direction, start_date)


