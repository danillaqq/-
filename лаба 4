def compare_action(manager):
    first, second = read_two_tours(manager)

    print(f"\nЦіна: {first.total_price:.2f} грн проти {second.total_price:.2f} грн")
    print(f"first < second: {first < second}")
    print(f"first > second: {first > second}")
    print(f"first == second: {first == second}")

    earlier = first if first.start_date <= second.start_date else second
    print(f"Раніше починається: {earlier.title} ({earlier.start_date:%d.%m.%Y})")

    for criterion, label in (("price", "ціною"), ("date", "датою початку")):
        print(f"\nТури за {label}:")
        for tour in manager.sorted_by(criterion):
            print(f"- {tour.title}: {tour.total_price:.2f} грн, {tour.start_date:%d.%m.%Y}")


