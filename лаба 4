def architecture_action(manager):
    print("\n--- Наслідування (IS-A) ---")
    for cls in (BeachTour, ExcursionTour, AdventureTour):
        print(f"{cls.__name__} наслідує {cls.__bases__[0].__name__}: {issubclass(cls, Tour)}")

    print("\n--- Композиція (HAS-A) ---")
    print(f"TourManager містить список із {len(manager)} об'єктів Tour:")
    for tour in manager.tours:
        print(f"- {tour.title}: клас {type(tour).__name__}, "
              f"є Tour: {isinstance(tour, Tour)}")


