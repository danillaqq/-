def failure_action(manager):
    manager.show_all()
    tour = manager.tour_at(read_int("\nНомер туру: "))
    customer = read_customer()
    print(f"Вільних місць до бронювання: {tour.free_seats}")

    try:
        with Booking(customer, tour) as booking:
            booking.confirm()
            raise RuntimeError("Збій платіжної системи")
    except RuntimeError as e:
        print("Помилку перехоплено ззовні:", e)

    manager.add_booking(booking)
    print(f"Вільних місць після збою: {tour.free_seats}")


