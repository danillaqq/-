def book_tour_action(manager):
    manager.show_all()
    tour = manager.tour_at(read_int("\nНомер туру: "))
    customer = read_customer()

    with Booking(customer, tour) as booking:
        answer = input("Підтвердити бронювання? (так/ні): ").lower()

        if answer == "так":
            booking.confirm()
        else:
            booking.cancel()

    manager.add_booking(booking)


