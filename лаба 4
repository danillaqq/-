@total_ordering
class Tour:
    def __init__(self, title, price, duration, tour_type, direction, start_date,
                 seats=10, service_fee=0):
        self._title = ""
        self._price = 0
        self._duration = 1
        self._start_date = None
        self._service_fee = 0
        self._reserved = 0
        self.tour_type = tour_type

        if not direction.strip():
            raise ValueError("Напрямок туру не може бути порожнім.")
        if seats < 1:
            raise ValueError("Кількість місць має бути не менше 1.")

        self.title = title
        self.price = price
        self.duration = duration
        self.direction = direction
        self.start_date = start_date
        self.seats = seats
        self.service_fee = service_fee

    @property
    def title(self):
        return self._title

    @title.setter
    def title(self, value):
        if len(value.strip()) < 3:
            raise ValueError("Назва туру має містити мінімум 3 символи.")
        self._title = value

    @property
    def price(self):
        return self._price

    @price.setter
    def price(self, value):
        if value < 0:
            raise ValueError("Ціна туру не може бути від'ємною.")
        self._price = value

    @property
    def duration(self):
        return self._duration

    @duration.setter
    def duration(self, value):
        if value <= 0:
            raise ValueError("Тривалість має бути більше 0 днів.")
        self._duration = value

    @property
    def start_date(self):
        return self._start_date

    @start_date.setter
    def start_date(self, value):
        if value < date.today():
            raise ValueError("Дата початку туру не може бути в минулому.")
        self._start_date = value

    @property
    def service_fee(self):
        return self._service_fee

    @service_fee.setter
    def service_fee(self, value):
        if value < 0:
            raise ValueError("Сервісний збір не може бути від'ємним.")
        self._service_fee = value

    @property
    def free_seats(self):
        return self.seats - self._reserved

    @property
    def is_available(self):
        return self.start_date > date.today() and self.free_seats > 0

    @property
    def total_price(self):
        return round(self.calculate_final_price() + self.service_fee, 2)

    def calculate_final_price(self):
        return self.price

    def reserve(self):
        if self.free_seats <= 0:
            raise ValueError("Вільних місць на цей тур немає.")
        self._reserved += 1

    def release(self):
        if self._reserved > 0:
            self._reserved -= 1

    def _specific_repr(self):
        return ""

    def __add__(self, other):
        if isinstance(other, Tour):
            return round(self.total_price + other.total_price, 2)
        if isinstance(other, (int, float)):
            result = copy(self)
            result._reserved = 0
            result.service_fee = self.service_fee + other
            return result
        return NotImplemented

    def __eq__(self, other):
        if not isinstance(other, Tour):
            return NotImplemented
        return self.total_price == other.total_price

    def __lt__(self, other):
        if not isinstance(other, Tour):
            return NotImplemented
        return self.total_price < other.total_price

    def __str__(self):
        return (f"{self.title} | {self.tour_type.value} | {self.direction} | "
                f"{self.start_date:%d.%m.%Y} | {self.duration} днів | "
                f"базова ціна {self.price:.2f} грн | "
                f"до сплати {self.total_price:.2f} грн")

    def __repr__(self):
        return (f"{type(self).__name__}({self.title!r}, {self.price!r}, "
                f"{self.duration!r}, {self._specific_repr()}"
                f"{self.direction!r}, {self.start_date!r})")


class BeachTour(Tour):
    def __init__(self, title, price, duration, all_inclusive, direction, start_date,
                 **options):
        super().__init__(title, price, duration, TourType.BEACH, direction,
                         start_date, **options)
        self.all_inclusive = all_inclusive

    def calculate_final_price(self):
        return self.price * 1.25 if self.all_inclusive else self.price

    def _specific_repr(self):
        return f"{self.all_inclusive!r}, "


class ExcursionTour(Tour):
    EXCURSION_COST = 300

    def __init__(self, title, price, duration, excursions, direction, start_date,
                 **options):
        super().__init__(title, price, duration, TourType.EXCURSION, direction,
                         start_date, **options)
        if excursions < 1:
            raise ValueError("Екскурсійний тур має містити хоча б одну екскурсію.")
        self.excursions = excursions

    def calculate_final_price(self):
        return self.price + self.excursions * self.EXCURSION_COST

    def _specific_repr(self):
        return f"{self.excursions!r}, "


class AdventureTour(Tour):
    def __init__(self, title, price, duration, difficulty, direction, start_date,
                 **options):
        super().__init__(title, price, duration, TourType.ADVENTURE, direction,
                         start_date, **options)
        if not 1 <= difficulty <= 5:
            raise ValueError("Складність має бути від 1 до 5.")
        self.difficulty = difficulty

    def calculate_final_price(self):
        return self.price * (1 + 0.1 * self.difficulty)

    def _specific_repr(self):
        return f"{self.difficulty!r}, "


class Booking:
    DEFAULT_TIMEOUT = 60

    def __init__(self, customer, tour, timeout=DEFAULT_TIMEOUT):
        self.customer = customer
        self.tour = tour
        self.timeout = timeout
        self.status = BookingStatus.PENDING
        self._started_at = None
        self._holds_seat = False

    @property
    def status(self):
        return self._status

    @status.setter
    def status(self, value):
        if not isinstance(value, BookingStatus):
            raise ValueError("Некоректний статус бронювання.")
        self._status = value

    def __enter__(self):
        if not self.tour.is_available:
            raise ValueError("Тур недоступний для бронювання.")
        self.tour.reserve()
        self._holds_seat = True
        self._started_at = time.monotonic()
        print(f"\n--- Початок бронювання (місце утримується {self.timeout} с) ---")
        return self

    def confirm(self):
        if self.status is not BookingStatus.PENDING:
            raise ValueError("Підтвердити можна лише бронювання, що очікує.")
        self.status = BookingStatus.CONFIRMED
        print("Бронювання підтверджено.")

    def cancel(self):
        self.status = BookingStatus.CANCELED
        self._release_seat()
        print("Бронювання скасовано.")

    def _release_seat(self):
        if self._holds_seat:
            self.tour.release()
            self._holds_seat = False

    def __exit__(self, exc_type, exc_val, exc_tb):
        elapsed = time.monotonic() - self._started_at
        if exc_type is not None:
            print(f"Помилка під час бронювання: {exc_val}. Місце звільнено.")
            self.status = BookingStatus.CANCELED
            self._release_seat()
        elif elapsed > self.timeout:
            print(f"Час вичерпано: {elapsed:.1f} с > {self.timeout} с. Місце звільнено.")
            self.status = BookingStatus.EXPIRED
            self._release_seat()
        elif self.status is BookingStatus.PENDING:
            self.status = BookingStatus.CANCELED
            self._release_seat()
        print(f"Фінальний статус: {self.status.value}")
        print("--- Завершення бронювання ---")
        return False

    def __str__(self):
        return f"{self.customer.name} | {self.tour.title} | {self.status.value}"

    def __repr__(self):
        return (f"Booking(customer={self.customer!r}, tour={self.tour.title!r}, "
                f"status={self.status.name})")


class AvailableTourIterator:
    def __init__(self, tours):
        self._queue = sorted((tour for tour in tours if tour.is_available),
                             key=lambda tour: tour.total_price)
        self._index = 0

    def __iter__(self):
        return self

    def __next__(self):
        if self._index >= len(self._queue):
            raise StopIteration
        tour = self._queue[self._index]
        self._index += 1
        return tour


class TourManager:
    SORT_KEYS = {
        "price": lambda tour: tour.total_price,
        "date": lambda tour: tour.start_date,
    }

    def __init__(self):
        self._tours = []
        self._bookings = []

    @property
    def tours(self):
        return tuple(self._tours)

    def add_tour(self, tour):
        if not isinstance(tour, Tour):
            raise TypeError("Можна додавати лише об'єкти Tour.")
        self._tours.append(tour)

    def add_booking(self, booking):
        self._bookings.append(booking)

    def __len__(self):
        return len(self._tours)

    def __iter__(self):
        return AvailableTourIterator(self._tours)

    def __repr__(self):
        return f"TourManager(tours={len(self._tours)}, bookings={len(self._bookings)})"

    def tour_at(self, number):
        if not 1 <= number <= len(self._tours):
            raise ValueError("Туру з таким номером немає.")
        return self._tours[number - 1]

    def find(self, keyword):
        keyword = keyword.strip().lower()
        return [tour for tour in self._tours
                if keyword in tour.title.lower() or keyword in tour.tour_type.value.lower()]

    def sorted_by(self, criterion):
        if criterion not in self.SORT_KEYS:
            raise ValueError("Сортувати можна лише за ціною або датою.")
        return sorted(self._tours, key=self.SORT_KEYS[criterion])

    def by_direction(self, direction):
        direction = direction.strip().lower()
        for tour in self._tours:
            if direction in tour.direction.lower():
                yield tour

    def within_budget(self, max_price):
        for tour in self._tours:
            if tour.total_price <= max_price:
                yield tour

    def in_period(self, start, end):
        if start > end:
            raise ValueError("Початок періоду пізніше за його кінець.")
        for tour in self._tours:
            if start <= tour.start_date <= end:
                yield tour

    def direction_statistics(self):
        stats = {tour.direction: [0, 0, 0.0] for tour in self._tours}
        for booking in self._bookings:
            row = stats[booking.tour.direction]
            row[0] += 1
            if booking.status is BookingStatus.CONFIRMED:
                row[1] += 1
                row[2] += booking.tour.total_price
        rows = [(direction, *values) for direction, values in stats.items()]
        return sorted(rows, key=lambda row: (-row[2], -row[1], row[0]))

    def export_statistics(self, filename):
        rows = self.direction_statistics()
        with open(filename, "w", newline="", encoding="utf-8-sig") as file:
            writer = csv.writer(file)
            writer.writerow(STATS_HEADER)
            for direction, requests, confirmed, revenue in rows:
                writer.writerow((direction, requests, confirmed, f"{revenue:.2f}"))
        return rows

    def show_all(self):
        print("\n--- Усі тури ---")
        for number, tour in enumerate(self._tours, start=1):
            print(f"{number}. {tour} | вільних місць: {tour.free_seats}")

    def show_bookings(self):
        print("\n--- Бронювання ---")
        if not self._bookings:
            print("Бронювань ще немає.")
        for number, booking in enumerate(self._bookings, start=1):
            print(f"{number}. {booking}")


def days_from_now(days):
    return date.today() + timedelta(days=days)


